{
  "name": "gymops",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "backend:migrate": "npm --workspace backend run migrate",
    "backend:dev": "npm --workspace backend run dev",
    "api:generate-types": "bun run --cwd apps/backend --bun scripts/manage.mjs spectacular --file schema.yml && openapi-typescript apps/backend/schema.yml -o apps/web/lib/api/generated/schema.d.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.7.4",
    "turbo": "^2.9.8",
    "typescript": "5.9.2"
  },
  "overrides": {
    "postcss": "8.5.13",
    "uuid": "14.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "expo": "^55.0.19",
    "next": "^16.2.4",
    "postcss": "^8.5.13"
  }
}
